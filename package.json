{
  "name": "abap-monorepo",
  "private": true,
  "version": "0.2.0",
  "description": "ABAP — consultancy services platform (apps/abap) and one workspace per client project (clients/*).",
  "workspaces": [
    "apps/*",
    "packages/*",
    "clients/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @abap/platform",
    "build": "npm run build -w @abap/platform",
    "preview": "npm run preview -w @abap/platform",
    "typecheck": "npm run typecheck -w @abap/platform",
    "lint": "npm run lint -w @abap/platform",
    "test": "npm run test -w @abap/platform",
    "test:e2e": "npm run test:e2e -w @abap/platform",
    "db:generate": "npm run db:generate -w @abap/platform",
    "db:migrate:local": "npm run db:migrate:local -w @abap/platform",
    "seed:local": "npm run seed:local -w @abap/platform",
    "db:reset:local": "npm run db:reset:local -w @abap/platform",
    "db:migrate:remote": "npm run db:migrate:remote -w @abap/platform",
    "seed:remote": "npm run seed:remote -w @abap/platform",
    "deploy": "npm run deploy -w @abap/platform",
    "deploy:kv-assets": "npm run deploy:kv-assets -w @abap/platform",
    "import:workbook": "npm run import:workbook -w @abap/platform",
    "extract:cleansea": "npm run extract:cleansea -w @abap/platform",
    "import:dv-criteria": "npm run import:dv-criteria -w @abap/platform",
    "client:new": "node tools/new-client.mjs",
    "docs:pull": "node tools/pull-drive-docs.mjs",
    "check:clients": "node tools/check-clients.mjs",
    "test:tools": "node --test \"tools/test/*.test.mjs\""
  }
}

{
  "name": "governance-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "npm run build && vite preview",
    "typecheck": "npm run cf-typegen && react-router typegen && tsc -b",
    "cf-typegen": "wrangler types",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "import:workbook": "python3 -I scripts/import_workbook.py data/source/Full_Stack_Governance_Workbook.xlsx data/seed/activities.v1.json",
    "db:generate": "drizzle-kit generate",
    "db:seed-sql": "tsx scripts/seed-sql.ts",
    "db:migrate:local": "wrangler d1 migrations apply governance --local",
    "seed:local": "npm run db:seed-sql && wrangler d1 execute governance --local --file=data/seed/seed.sql",
    "db:reset:local": "rm -rf .wrangler/state && npm run db:migrate:local && npm run seed:local"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "isbot": "^5.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "~1.63.0",
    "@react-router/dev": "^7.18.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.160.1"
  }
}

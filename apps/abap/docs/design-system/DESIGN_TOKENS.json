{
  "$description": "Normalized design tokens (DTCG format). Source of truth: workbook sheet 'Design Tokens' (data/source/Full_Stack_Governance_Workbook.xlsx). app/app.css MUST match these values (tests/unit/design-system.test.ts). Tokens from the CleanSea and Workspace prototypes are inventoried in COMPONENT_INVENTORY.md and NOT adopted (one identity).",
  "$metadata": { "version": "1.0.0", "status": "PROPOSED", "adr": "ADR-004" },
  "color": {
    "bg": {
      "1": { "$type": "color", "$value": "#ffffff", "$description": "Base surface: cards, inputs", "css": "--card" },
      "2": { "$type": "color", "$value": "#fafafa", "$description": "Page background", "css": "--background" },
      "3": { "$type": "color", "$value": "#f5f5f5", "$description": "Calculated / output fields, table headers", "css": "--muted" },
      "4": { "$type": "color", "$value": "#f0f0f0", "$description": "Section bands, separators, hover", "css": "--accent" }
    },
    "stroke": {
      "1": { "$type": "color", "$value": "#d1d1d1", "$description": "Borders of fields, tables, nodes", "css": "--border" }
    },
    "fg": {
      "1": { "$type": "color", "$value": "#242424", "$description": "Main text; DONE status fill", "css": "--foreground" },
      "2": { "$type": "color", "$value": "#424242", "$description": "Secondary text, labels", "css": "--secondary-foreground" },
      "3": { "$type": "color", "$value": "#616161", "$description": "Support text; NOT STARTED", "css": "--muted-foreground" }
    },
    "brand": {
      "default": { "$type": "color", "$value": "#0f6cbd", "$description": "Action, navigation, user input border, links, focus", "css": "--primary" },
      "fg": { "$type": "color", "$value": "#115ea3", "$description": "Text on brand tint", "css": "--brand-fg" },
      "tint": { "$type": "color", "$value": "#ebf3fc", "$description": "Selected / active background", "css": "--brand-tint" },
      "tint2": { "$type": "color", "$value": "#cfe4fa", "$description": "Review / approval intermediate state", "css": "--brand-tint-2" }
    },
    "alert": { "$type": "color", "$value": "#b10e1c", "$description": "ONLY functional accent: blocked, critical, flags", "css": "--destructive" }
  },
  "status": {
    "not-started": { "$type": "color-pair", "$value": { "bg": "{color.bg.3}", "fg": "{color.fg.3}" } },
    "in-progress": { "$type": "color-pair", "$value": { "bg": "{color.brand.tint}", "fg": "{color.brand.fg}" }, "$description": "IN PROGRESS, PREPARED" },
    "in-review": { "$type": "color-pair", "$value": { "bg": "{color.brand.tint2}", "fg": "{color.brand.fg}" }, "$description": "IN REVIEW, APPROVED" },
    "verified": { "$type": "color-pair", "$value": { "bg": "{color.brand.default}", "fg": "{color.bg.1}" } },
    "done": { "$type": "color-pair", "$value": { "bg": "{color.fg.1}", "fg": "{color.bg.1}" }, "$description": "DONE with evidence" },
    "blocked": { "$type": "color-pair", "$value": { "bg": "{color.alert}", "fg": "{color.bg.1}" } }
  },
  "type": {
    "family": { "$type": "fontFamily", "$value": ["Segoe UI", "Arial", "ui-sans-serif", "system-ui", "sans-serif"], "css": "--font-sans" },
    "title": { "$type": "dimension", "$value": "24px", "$description": "Page title (h1)" },
    "body": { "$type": "dimension", "$value": "14px" },
    "small": { "$type": "dimension", "$value": "12px" }
  },
  "radius": {
    "md": { "$type": "dimension", "$value": "0.375rem", "css": "--radius" },
    "node": { "$type": "dimension", "$value": "4px", "$description": "Diagram node corner (square geometry, ADR diagramming system)" }
  },
  "space": {
    "unit": { "$type": "dimension", "$value": "4px" },
    "gutter": { "$type": "dimension", "$value": "16px" }
  },
  "focus": {
    "outline": { "$type": "dimension", "$value": "2px solid {color.brand.default}", "$description": "Global :focus-visible outline, offset 2px" }
  },
  "diagram": {
    "node": {
      "width": { "$type": "dimension", "$value": "184px" },
      "height": { "$type": "dimension", "$value": "80px" },
      "border-solid": { "$type": "strokeStyle", "$value": "solid", "$description": "Executable / validated element" },
      "border-dashed": { "$type": "strokeStyle", "$value": "dashed", "$description": "Gap, not validated or future element" }
    },
    "edge": {
      "flow": { "$type": "strokeStyle", "$value": "solid", "$description": "Sequence; arrow head" },
      "dependency": { "$type": "strokeStyle", "$value": "solid", "$description": "Predecessor → dependent; arrow head" },
      "hierarchy": { "$type": "strokeStyle", "$value": "solid", "$description": "Parent – child; no arrow; low emphasis" },
      "association": { "$type": "strokeStyle", "$value": "dashed", "$description": "Relationship; no arrow" }
    }
  }
}

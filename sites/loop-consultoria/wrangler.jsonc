{
  // Loop Consultoria landing page (account adm-loop-app). Deploy: npx wrangler deploy (from this folder).
  "name": "loop-consultoria",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "rules": [{ "type": "Text", "globs": ["**/*.html", "**/*.css"], "fallthrough": true }],
  "d1_databases": [{ "binding": "DB", "database_name": "loop-site-leads", "database_id": "d86a8249-dd5d-4f3b-8bf7-f26e423afdd6" }]
}
